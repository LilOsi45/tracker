# Secrets. Copy to .env — never commit the real file.

# Free tier: 1M credits/month, 10 req/s. helius.dev
HELIUS_API_KEY=

# Optional. The public RugCheck API works without a key at ~1 req/s.
RUGCHECK_API_KEY=

# Phase 2 only.
DISCORD_WEBHOOK_URL=

# Leave empty for local use. Set a long random string once this is
# reachable from the internet, and put the same value in the PWA.
ACCESS_TOKEN=

# Comma-separated. Tighten to your own domain in production.
CORS_ORIGINS=*
